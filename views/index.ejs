<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

    <link rel="stylesheet" href="css/style.css" />
  </head>
  <body>
    <div class="app-container">
      <!-- Sidebar Controls -->
      <aside class="controls-panel">
        <button
          id="resetBtn"
          class="secondary-btn"
          style="margin-top: 8px; width: 100%"
        >
          🔄 پاک‌سازی و شروع مجدد (Reset)
        </button>
        <h1>ویرایشگر تصویر</h1>

        <div class="control-group">
          <label for="imageUpload">۱. بارگذاری تصاویر (تکی یا چندگانه)</label>
          <input
            type="file"
            id="imageUpload"
            accept="image/*"
            multiple
            autocomplete="off"
          />
        </div>

        <div class="control-group">
          <label for="textInput">متن آزمایشی (برای تنظیم روی کانواس)</label>
          <input
            type="text"
            id="textInput"
            placeholder="متن را اینجا بنویسید..."
            autocomplete="off"
          />
        </div>

        <div class="control-group">
          <label for="fontFamily">نوع قلم</label>

          <select id="fontFamily" style="display: none" autocomplete="off">
            <optgroup label="🇮🇷 قلم‌های فارسی">
              <option value="BNazanin">B Nazanin (بی نازنین)</option>
              <option value="BSahra">B Sahra (بی صحرا)</option>
              <option value="BYekan" selected>B Yekan (بی یکان)</option>
              <option value="IranNastaliq">
                Iran Nastaliq (ایران نستعلیق)
              </option>
              <option value="Mandana MRT">Mandana (ماندانا)</option>
              <option value="Shablon MRT">Shablon (شابلون)</option>
            </optgroup>
            <optgroup label="🇬🇧 قلم‌های انگلیسی و تزئینی">
              <option value="Callite">Callite</option>
              <option value="CANAVAR">CANAVAR</option>
              <option value="Decoration">Decoration</option>
              <option value="Deep Hero">Deep Hero</option>
              <option value="Diane Amorta">Diane Amorta</option>
              <option value="Gemini">Gemini</option>
              <option value="Handwash">Handwash</option>
              <option value="Honey Crepes">Honey Crepes</option>
              <option value="Party Script">Party Script</option>
              <option value="Rockers Garage">Rockers Garage</option>
              <option value="Runtoe">Runtoe</option>
              <option value="SHUTTLE-X">SHUTTLE-X</option>
              <option value="Sunny Spells Basic">Sunny Spells Basic</option>
              <option value="The Kanzie TTF">The Kanzie TTF</option>
              <option value="Think Smart">Think Smart</option>
              <option value="Young Man">Young Man</option>
            </optgroup>
          </select>

          <div class="custom-font-select" id="fontFamilyCustom">
            <div class="custom-font-select-header">
              <span
                id="fontFamilySelectedText"
                style="font-family: &quot;BYekan&quot;"
                >B Yekan (بی یکان)</span
              >
              <span class="custom-font-arrow">▼</span>
            </div>
            <div class="custom-font-select-options hidden">
              <div class="custom-font-optgroup">🇮🇷 قلم‌های فارسی</div>
              <div
                class="custom-font-option"
                data-value="BNazanin"
                style="font-family: &quot;BNazanin&quot;"
              >
                B Nazanin (بی نازنین)
              </div>
              <div
                class="custom-font-option"
                data-value="BSahra"
                style="font-family: &quot;BSahra&quot;"
              >
                B Sahra (بی صحرا)
              </div>
              <div
                class="custom-font-option active"
                data-value="BYekan"
                style="font-family: &quot;BYekan&quot;"
              >
                B Yekan (بی یکان)
              </div>
              <div
                class="custom-font-option"
                data-value="IranNastaliq"
                style="font-family: &quot;IranNastaliq&quot;"
              >
                Iran Nastaliq (ایران نستعلیق)
              </div>
              <div
                class="custom-font-option"
                data-value="Mandana MRT"
                style="font-family: &quot;Mandana MRT&quot;"
              >
                Mandana (ماندانا)
              </div>
              <div
                class="custom-font-option"
                data-value="Shablon MRT"
                style="font-family: &quot;Shablon MRT&quot;"
              >
                Shablon (شابلون)
              </div>

              <div class="custom-font-optgroup">
                🇬🇧 قلم‌های انگلیسی و تزئینی
              </div>
              <div
                class="custom-font-option"
                data-value="Callite"
                style="font-family: &quot;Callite&quot;"
              >
                Callite
              </div>
              <div
                class="custom-font-option"
                data-value="CANAVAR"
                style="font-family: &quot;CANAVAR&quot;"
              >
                CANAVAR
              </div>
              <div
                class="custom-font-option"
                data-value="Decoration"
                style="font-family: &quot;Decoration&quot;"
              >
                Decoration
              </div>
              <div
                class="custom-font-option"
                data-value="Deep Hero"
                style="font-family: &quot;Deep Hero&quot;"
              >
                Deep Hero
              </div>
              <div
                class="custom-font-option"
                data-value="Diane Amorta"
                style="font-family: &quot;Diane Amorta&quot;"
              >
                Diane Amorta
              </div>
              <div
                class="custom-font-option"
                data-value="Gemini"
                style="font-family: &quot;Gemini&quot;"
              >
                Gemini
              </div>
              <div
                class="custom-font-option"
                data-value="Handwash"
                style="font-family: &quot;Handwash&quot;"
              >
                Handwash
              </div>
              <div
                class="custom-font-option"
                data-value="Honey Crepes"
                style="font-family: &quot;Honey Crepes&quot;"
              >
                Honey Crepes
              </div>
              <div
                class="custom-font-option"
                data-value="Party Script"
                style="font-family: &quot;Party Script&quot;"
              >
                Party Script
              </div>
              <div
                class="custom-font-option"
                data-value="Rockers Garage"
                style="font-family: &quot;Rockers Garage&quot;"
              >
                Rockers Garage
              </div>
              <div
                class="custom-font-option"
                data-value="Runtoe"
                style="font-family: &quot;Runtoe&quot;"
              >
                Runtoe
              </div>
              <div
                class="custom-font-option"
                data-value="SHUTTLE-X"
                style="font-family: &quot;SHUTTLE-X&quot;"
              >
                SHUTTLE-X
              </div>
              <div
                class="custom-font-option"
                data-value="Sunny Spells Basic"
                style="font-family: &quot;Sunny Spells Basic&quot;"
              >
                Sunny Spells Basic
              </div>
              <div
                class="custom-font-option"
                data-value="The Kanzie TTF"
                style="font-family: &quot;The Kanzie TTF&quot;"
              >
                The Kanzie TTF
              </div>
              <div
                class="custom-font-option"
                data-value="Think Smart"
                style="font-family: &quot;Think Smart&quot;"
              >
                Think Smart
              </div>
              <div
                class="custom-font-option"
                data-value="Young Man"
                style="font-family: &quot;Young Man&quot;"
              >
                Young Man
              </div>
            </div>
          </div>
        </div>

        <div class="control-group">
          <label for="fontSize"
            >اندازه قلم: <span id="fontSizeValue">40</span>px</label
          >
          <input
            type="range"
            id="fontSize"
            min="10"
            max="1000"
            value="40"
            autocomplete="off"
          />
        </div>

        <div class="control-group">
          <label for="textBoxWidth"
            >عرض کادر متن: <span id="textBoxWidthValue">80</span>%</label
          >
          <input
            type="range"
            id="textBoxWidth"
            min="10"
            max="100"
            value="80"
            autocomplete="off"
          />
        </div>

        <div class="control-group">
          <label for="textBoxHeight"
            >ارتفاع کادر متن: <span id="textBoxHeightValue">40</span>%</label
          >
          <input
            type="range"
            id="textBoxHeight"
            min="10"
            max="100"
            value="40"
            autocomplete="off"
          />
        </div>

        <div class="control-group">
          <label for="textColor">رنگ متن</label>
          <div class="color-picker-wrapper">
            <input
              type="color"
              id="textColor"
              value="#ffffff"
              autocomplete="off"
            />
            <span id="colorHex">#ffffff</span>
          </div>
        </div>

        <div class="control-group">
          <label for="imageStyle">🎨 استایل و فیلتر تصویر</label>
          <select id="imageStyle" autocomplete="off">
            <option value="none">ساده (بدون افکت)</option>
            <option value="grayscale(100%)">سیاه و سفید (B&W)</option>
            <option value="invert(100%)">نگاتیو (Negative)</option>
            <option value="contrast(160%)">کنتراست بالا (High Contrast)</option>
            <option value="sepia(100%)">سپیا (قدیمی)</option>
            <option value="sepia(40%) contrast(110%) brightness(90%)">
              وینتیج (Vintage)
            </option>
            <option value="brightness(130%) contrast(105%)">
              روشن (Bright)
            </option>
            <option value="brightness(80%) contrast(130%) saturate(80%)">
              تیره و سینمایی (Moody)
            </option>
          </select>
        </div>

        <div class="control-group">
          <label for="watermarkUpload">💧 واترمارک (اختیاری)</label>
          <input
            type="file"
            id="watermarkUpload"
            accept="image/*"
            autocomplete="off"
          />
          <p
            class="hint"
            style="font-size: 0.75rem; margin-top: 4px; text-align: right"
          >
            تصویر واترمارک در گوشه پایین و راست تمام تصاویر و ویدیوها قرار
            می‌گیرد.
          </p>
        </div>

        <div class="control-group">
          <label for="allTexts"
            >متن‌ها (هر خط یک خروجی - تقسیم بین تصاویر)</label
          >
          <textarea
            id="allTexts"
            rows="15"
            placeholder="متن ۱&#10;متن ۲&#10;..."
            autocomplete="off"
          ></textarea>
          <p
            class="hint"
            style="font-size: 0.75rem; margin-top: 4px; text-align: right"
          >
            متن‌ها به ترتیب و به صورت مساوی بین تمام تصاویر بارگذاری شده تقسیم
            می‌شوند.
          </p>
        </div>

        <div class="control-group">
          <button id="downloadBtn" class="primary-btn">
            ⬇ دانلود تصویر کانواس
          </button>
        </div>
      </aside>

      <!-- Main Preview Area -->
      <main class="preview-panel">
        <div style="margin-bottom: 2px; text-align: center">
          <button
            id="downloadAllZipBtn"
            class="primary-btn"
            style="
              background-color: #10b981;
              margin: 0 auto;
              display: inline-block;
            "
          >
            📦 دانلود تمام دسته‌ها در یک فایل ZIP
          </button>
        </div>

        <!-- 🔥 UPDATED: Added Global Zone Button -->
        <div class="image-selector-wrapper">
          <div
            style="
              display: flex;
              justify-content: space-between;
              align-items: center;
              margin-bottom: 10px;
              gap: 10px;
              flex-wrap: wrap;
            "
          >
            <h3 style="margin: 0">انتخاب تصویر پس‌زمینه برای ویرایش:</h3>

            <!-- 🔥 UPDATED: Grouped Global Zone and Global Produce Buttons -->
            <div style="display: flex; gap: 8px; flex-wrap: wrap">
              <button
                id="drawGlobalZoneBtn"
                class="secondary-btn"
                style="
                  width: auto;
                  margin: 0;
                  padding: 8px 16px;
                  font-size: 0.9rem;
                  white-space: nowrap;
                "
              >
                🌍 رسم ناحیه گلوبال
              </button>
              <button
                id="generateAllBtn"
                class="primary-btn"
                style="
                  width: auto;
                  margin: 0;
                  padding: 8px 16px;
                  font-size: 0.9rem;
                  white-space: nowrap;
                  background-color: #f59e0b;
                  border-color: #d97706;
                "
              >
                ✨ تولید برای همه
              </button>
            </div>
          </div>
          <div class="image-selector" id="imageSelector">
            <p class="hint">ابتدا تصاویر را بارگذاری کنید...</p>
          </div>
        </div>

        <div class="canvas-and-controls">
          <div class="canvas-wrapper">
            <canvas id="editorCanvas"></canvas>
            <div id="placeholderText">
              برای شروع ویرایش، یک تصویر بارگذاری کنید
            </div>
          </div>

          <div id="editVideoControls" class="edit-video-controls hidden">
            <h3>🎥 ساخت ویدیو برای این تصویر</h3>
            <div class="control-group">
              <label for="videoEffect">نوع افکت ویدیو:</label>
              <select id="videoEffect" autocomplete="off">
                <option value="none">بدون افکت (ساده)</option>
                <option value="particles">✨ ذرات معلق (Floats/Bokeh)</option>
                <option value="kenburns">🔍 بزرگنمایی آرام (Ken Burns)</option>
                <option value="zoomout">🔙 کوچک‌نمایی آرام (Zoom Out)</option>
                <option value="pan">↔️ حرکت آرام افقی (Pan)</option>
                <option value="wavy">🌊 افکت موج‌دار متحرک (Wavy)</option>
                <option value="shake">📳 لرزش خفیف سینمایی (Shake)</option>
                <option value="pulse">💓 ضربان آرام (Pulse)</option>
                <option value="rotate">🔄 چرخش آرام (Rotate)</option>
                <option value="glitch">📺 گلیچ / نویز دیجیتال (Glitch)</option>
                <option value="vhs">📼 افکت نوار ویدیویی (VHS)</option>
                <option value="hue">🌈 تغییر رنگ متحرک (Hue Shift)</option>
                <option value="blur">🌫️ تاری متحرک (Blur)</option>
                <option value="fade">🌑 محو شدن (Fade)</option>
                <option value="zoompulse">🔎 زوم ضربانی (Zoom Pulse)</option>
                <option value="slideleft">⬅️ اسلاید از چپ (Slide Left)</option>
                <option value="slideup">⬆️ اسلاید از پایین (Slide Up)</option>
                <option value="flash">⚡ فلش نوری (Flash)</option>
                <option value="invert_pulse">
                  🌓 ضد رنگ متحرک (Invert Pulse)
                </option>
                <option value="flip">🔁 چرخش افقی (Flip)</option>
              </select>
            </div>
            <div class="control-group">
              <label for="audioUploadEdit">🎵 موسیقی پس‌زمینه (MP3):</label>
              <input
                type="file"
                id="audioUploadEdit"
                accept="audio/*"
                autocomplete="off"
              />
            </div>
            <div class="control-group">
              <label for="videoDuration">⏱️ مدت زمان ویدیو (ثانیه):</label>
              <input
                type="number"
                id="videoDuration"
                min="1"
                max="120"
                value="5"
                step="1"
                autocomplete="off"
              />
            </div>
            <button
              id="generateVideoBtnEdit"
              class="primary-btn video-btn-style"
            >
              🎥 ساخت و دانلود ویدیو
            </button>
          </div>

          <!-- 🔥 UPDATED: Batch Video Generation Controls -->
          <div
            id="batchVideoControls"
            class="edit-video-controls hidden"
            style="border-top-color: #8b5cf6"
          >
            <h3>🎬 ساخت گروهی ویدیو (Batch Video Generation)</h3>

            <div class="control-group">
              <label for="batchEffectSelect"
                >🎨 افکت ویدیو (برای همه ویدیوها):</label
              >
              <select id="batchEffectSelect" autocomplete="off">
                <option value="none">بدون افکت (ساده)</option>
                <option value="particles">✨ ذرات معلق (Floats/Bokeh)</option>
                <option value="kenburns">🔍 بزرگنمایی آرام (Ken Burns)</option>
                <option value="zoomout">🔙 کوچک‌نمایی آرام (Zoom Out)</option>
                <option value="pan">↔️ حرکت آرام افقی (Pan)</option>
                <option value="wavy">🌊 افکت موج‌دار متحرک (Wavy)</option>
                <option value="shake">📳 لرزش خفیف سینمایی (Shake)</option>
                <option value="pulse">💓 ضربان آرام (Pulse)</option>
                <option value="rotate">🔄 چرخش آرام (Rotate)</option>
                <option value="glitch">📺 گلیچ / نویز دیجیتال (Glitch)</option>
                <option value="vhs">📼 افکت نوار ویدیویی (VHS)</option>
                <option value="hue">🌈 تغییر رنگ متحرک (Hue Shift)</option>
                <option value="blur">🌫️ تاری متحرک (Blur)</option>
                <option value="fade">🌑 محو شدن (Fade)</option>
                <option value="zoompulse">🔎 زوم ضربانی (Zoom Pulse)</option>
                <option value="slideleft">⬅️ اسلاید از چپ (Slide Left)</option>
                <option value="slideup">⬆️ اسلاید از پایین (Slide Up)</option>
                <option value="flash">⚡ فلش نوری (Flash)</option>
                <option value="invert_pulse">
                  🌓 ضد رنگ متحرک (Invert Pulse)
                </option>
                <option value="flip">🔁 چرخش افقی (Flip)</option>
              </select>
            </div>

            <div class="control-group">
              <label for="batchAudioUpload">🎵 آپلود فایل‌های MP3:</label>
              <input
                type="file"
                id="batchAudioUpload"
                accept="audio/*"
                multiple
                autocomplete="off"
              />
            </div>

            <div id="batchMp3List" class="batch-mp3-list hidden">
              <!-- Dynamically populated by JS -->
            </div>

            <div class="control-group">
              <label for="batchVideoDuration"
                >⏱️ مدت زمان هر ویدیو (ثانیه):</label
              >
              <input
                type="number"
                id="batchVideoDuration"
                min="1"
                max="120"
                value="5"
                step="1"
                autocomplete="off"
              />
            </div>

            <button
              id="generateBatchVideosBtn"
              class="primary-btn video-btn-style"
              style="background-color: #8b5cf6 !important"
            >
              🚀 ساخت گروهی ویدیوها (MP4)
            </button>

            <div
              id="batchProgressContainer"
              class="batch-progress-container hidden"
            >
              <div class="progress-bar-wrapper">
                <div id="batchProgressBar" class="progress-bar-fill"></div>
              </div>
              <p id="batchProgressText" class="progress-text">
                در حال آماده‌سازی...
              </p>
            </div>
          </div>
        </div>

        <div class="categorized-previews-wrapper">
          <h2>پیش‌نمایش‌های دسته‌بندی شده</h2>

          <div id="categorizedPreviews" class="categorized-previews"></div>
        </div>
      </main>
    </div>

    <!-- 🔥 UPDATED: Removed FFmpeg.wasm, only include custom scripts -->
    <script src="js/VideoRecorder.js"></script>
    <script src="js/BatchVideoManager.js"></script>
    <script src="js/editor.js"></script>
  </body>
</html>
